{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan test:*)",
      "Bash(php artisan scramble:export:*)",
      "Bash(composer show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec -T app vendor/bin/pest:*)",
      "Bash(docker compose exec -T -e DB_CONNECTION=pgsql -e DB_DATABASE=gestopago_test app vendor/bin/pest:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(cat .env:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pint-format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
