APP_NAME="Gesto Pago API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de datos (PostgreSQL con el esquema "gestopago") ----------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestopago
DB_USERNAME=gestopago
DB_PASSWORD=
DB_SSLMODE=prefer

# Base usada por las rutas heredadas /api/DEVELOP/* (vacío = misma que DB_*)
# DB_DEVELOP_HOST=
# DB_DEVELOP_DATABASE=
# DB_DEVELOP_USERNAME=
# DB_DEVELOP_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- API ---------------------------------------------------------------------------
API_RATE_LIMIT=120
API_KEY_CACHE_TTL=60
API_DOCS_ENABLED=false
# Orígenes permitidos separados por coma (* = cualquiera, sin credenciales)
CORS_ALLOWED_ORIGINS=*

# --- Gesto Pago --------------------------------------------------------------------
# URL base del proveedor (sandbox o producción) y rutas de cada operación.
GESTOPAGO_BASE_URL=
GESTOPAGO_TOKEN_PATH=
GESTOPAGO_ECHO_PATH=
GESTOPAGO_VALIDATE_ME_PATH=
GESTOPAGO_BALANCE_PATH=
GESTOPAGO_PRODUCTS_PATH=
GESTOPAGO_SEND_TX_PATH=
GESTOPAGO_CONFIRM_TX_PATH=
GESTOPAGO_VERIFY_REFERENCE_PATH=

# Credenciales del endpoint de token (las entrega Gesto Pago por ambiente)
GESTOPAGO_DISTRIBUTOR_ID=
GESTOPAGO_DEVICE_CODE=
GESTOPAGO_PASSWORD=

# AES-256-CBC en base64 (SECRET_KEY / IV del proveedor)
GESTOPAGO_SECRET_KEY=
GESTOPAGO_SECRET_IV=

GESTOPAGO_CONNECT_TIMEOUT=10
GESTOPAGO_TIMEOUT=60
GESTOPAGO_RETRIES=2
# cache | database (comparte el token con wsgestopago mientras convivan)
GESTOPAGO_TOKEN_STORE=cache
GESTOPAGO_TOKEN_TTL=82800
GESTOPAGO_TIMEZONE=America/Mexico_City

GESTOPAGO_LOW_BALANCE_THRESHOLD=5000
# URL completa del core para el aviso de saldo (antes URL_CORE + "gp/avisosaldo")
GESTOPAGO_LOW_BALANCE_NOTIFY_URL=

# Solo sandbox/local: /api/v1/diagnostics/* y encryptData/getJWT heredados
GESTOPAGO_DIAGNOSTICS_ENABLED=false

# Rutas heredadas /api/{PRODUCTION|DEVELOP}/* de wsgestopago
GESTOPAGO_LEGACY_ROUTES=true
GESTOPAGO_LEGACY_PRODUCTION_CONNECTION=pgsql
GESTOPAGO_LEGACY_DEVELOP_CONNECTION=pgsql_develop
