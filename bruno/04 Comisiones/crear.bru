meta {
  name: Registrar comisión
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/businesses/{{businessId}}/commissions
  body: json
  auth: inherit
}

body:json {
  {
    "commission": "3.5"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("commissionId", res.getBody().data[0].id);
  }
}
