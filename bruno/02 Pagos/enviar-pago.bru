meta {
  name: Enviar pago
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/payments
  body: json
  auth: inherit
}

body:json {
  {
    "businessId": {{businessId}},
    "idServicio": 1,
    "idProducto": 1,
    "telefono": "5512345678",
    "montoPago": 100
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("upc", res.getBody().data.upc);
  }
}

tests {
  test("201 con autorización y upc", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.upc).to.match(/^[a-f0-9]{14}$/);
  });
}
